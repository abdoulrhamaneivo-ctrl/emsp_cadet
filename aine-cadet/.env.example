# --- Base de donnÃ©es ---
# Sans DB_ENGINE (ou valeur autre que mysql) â†’ SQLite automatique (db.sqlite3)
#
# MySQL â€” une seule commande SQL cÃ´tÃ© serveur (voir docs/MYSQL.md) :
#   CREATE DATABASE emspconnect CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Puis lancer : .\scripts\setup-mysql.ps1
#
DB_ENGINE=mysql
DB_NAME=emspconnect
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
#
# XAMPP avec MariaDB 10.4 (Django 5 exige 10.5+) â€” dev local uniquement :
MYSQL_ALLOW_LEGACY=1
#
# PostgreSQL (production Docker â€” voir docs/DEPLOIEMENT.md) :
# DATABASE_URL=postgres
# DB_NAME=aine_cadet
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- URLs publiques ---
# EMSP_VITRINE_URL=https://www.emsp.int
# AINE_CADET_PUBLIC_URL=https://api.emsp.int
SCHOOL_EMAIL_DOMAIN=emsp.int

# --- E-mails transactionnels (Brevo â€” ex-Sendinblue) ---
# CrÃ©er un compte sur https://www.brevo.com puis gÃ©nÃ©rer une clÃ© API v3.
# VÃ©rifier le domaine expÃ©diteur (SPF/DKIM) dans Brevo avant la mise en prod.
BREVO_API_KEY=
# Adresse expÃ©diteur â€” doit Ãªtre authentifiÃ©e dans Brevo (noreply ou contact@emsp.int)
DEFAULT_FROM_EMAIL=noreply@emsp.int
