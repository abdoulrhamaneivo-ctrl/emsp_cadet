# Copier vers .env (jamais commité) — backend Django EMSP Connect.
# En local, config.settings.dev utilise SQLite et ne requiert pas ces secrets.

# Render : config.settings.prod. Générer une vraie clé secrète dans Render.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-moi-en-production

# Utiliser la connection string PostgreSQL pooled de Neon (ne jamais la committer).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# URL exacte du front Vercel (sans slash final), utilisée pour CORS et CSRF.
FRONT_ORIGIN=https://emsp-connect.vercel.app

# Dans Render, ajouter CLOUDINARY_URL depuis le tableau de bord Cloudinary.
# Exemple de forme uniquement : cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
