    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.8.0",
    "framer-motion": "^12.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.9.4",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.1.14",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
