# EMSP Connect — variables d'environnement frontend
# Copier en .env.local puis ajuster.

# URL de l'API. Vide = appels /api sur la même origine (proxy Vercel en production).
VITE_API_URL=

# 1 = démarrer MSW pour le développement visuel. Toujours 0 en production.
VITE_ENABLE_MOCKS=0

# URL WebSocket du backend. Laisser vide en développement local pour le simulateur.
# En production : wss://emsp-connect-api.onrender.com
VITE_WS_URL=

# 1 = pré-authentifier avec l'utilisateur mocké. Toujours 0 en production.
VITE_DEMO_SESSION=0
