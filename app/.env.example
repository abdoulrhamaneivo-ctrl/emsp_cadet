# EMSP Connect — variables d'environnement frontend
# Copier en .env.local puis ajuster.

# URL de l'API. Vide = même origine (reverse proxy) — backend DRF à partir de T3.
VITE_API_URL=

# 1 = démarrer MSW (mocks conformes aux contrats des docs 04-17). 0 ou absent = API réelle.
VITE_ENABLE_MOCKS=1

# 1 = pré-authentifier avec l'utilisateur mocké (démo du shell protégé).
# Uniquement pour le dev visuel — retirer dès que LoginPage est branchée (T1).
VITE_DEMO_SESSION=0
